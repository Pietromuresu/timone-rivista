.git
.gitignore
.github

vendor
node_modules

.env
.env.*
!.env.example

storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore

# Manifest di package discovery/config compilati in locale: contengono anche
# i provider delle dev-dependency (es. laravel/pail) che "composer install
# --no-dev" esclude dall'immagine — vanno rigenerati nel Dockerfile con la
# vendor/ giusta (php artisan package:discover), mai copiati dall'host.
bootstrap/cache/*.php

database/*.sqlite

public/build
public/hot

backups

.phpunit.cache
.phpunit.result.cache
tests
.claude

*.md
!README.md
# Bug 3 (2026-10-12): il manuale è letto a runtime da /manuale
# (DocumentationController) — senza questa eccezione mancava
# dall'immagine di produzione e la pagina andava in errore 500.
!MANUALE_UTENTE.md
# Manuale a pagine (2026-10-29): le pagine sono lette a runtime da
# /manuale/{slug} (App\Support\Manual\ManualRepository). «*.md» qui sopra
# vale solo per la cartella principale (verificato con una build: i .md di
# resources/manuale/ e di docs/ entrano comunque nell'immagine); l'eccezione
# esplicita resta per chiarezza, nel caso la regola diventi «**/*.md».
!resources/manuale/*.md
# Le immagini del manuale (Fase 4) stanno in public/manuale/img: non sono
# escluse da nessuna regola sopra.
