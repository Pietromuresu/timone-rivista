# =============================================================================
# Configurazione del backup automatico di Timone (servizio «backup-agent»).
#
# Questo file è un MODELLO: tutti i valori sono finti. ./setup.sh lo copia in
# «backup.env» la prima volta (e genera da solo password e utente del
# database); da lì in poi backup.env è tuo e setup.sh non lo tocca più.
#
# backup.env NON va su git né nell'immagine Docker (.gitignore e
# .dockerignore lo escludono): contiene credenziali. Guida completa:
# docs/OPERATIONS.md, sezione «Backup e ripristino».
#
# Il servizio rilegge questo file a ogni esecuzione: dopo una modifica non
# serve riavviare nulla, vale dal backup successivo.
# =============================================================================

# --- Chiave di cifratura -----------------------------------------------------
# File che contiene la password del repository restic (la chiave di
# cifratura dei backup). Percorso relativo alla cartella del progetto.
# setup.sh lo genera con permessi 600. SENZA QUESTA PASSWORD I BACKUP NON SI
# POSSONO LEGGERE: copiala subito in un password manager fuori dal server.
# Non scrivere mai la password qui (RESTIC_PASSWORD=…): backup.env viene
# salvato nel backup e la password finirebbe sulla destinazione.
RESTIC_PASSWORD_FILE=backup-secrets/restic-password

# --- Utente MySQL in sola lettura usato per il dump ---------------------------
# setup.sh crea l'utente in MySQL con questi valori (solo SELECT e simili:
# il backup non può modificare il database). La password la genera setup.sh.
BACKUP_DB_USER=timone_backup
BACKUP_DB_PASSWORD=password-finta-generata-da-setup

# --- Copia remota (fuori dal server) ------------------------------------------
# Finché resta DA_CONFIGURARE i backup si fanno lo stesso, ma solo sul
# server: una mail al giorno lo ricorda. Appena la compili, al giro
# successivo parte da sola la prima copia remota completa.
# Prova la configurazione con:  ./setup.sh backup-check
#
# Ammessi SOLO due tipi, perché solo questi sono protetti dal lato della
# destinazione contro un server compromesso (che ha queste stesse credenziali):
#   rest-server con TLS, autenticazione e --append-only:
#     BACKUP_REMOTE_REPOSITORY=rest:https://backup.esempio.it:8000/timone/
#   S3 con Object Lock in modalità COMPLIANCE (chiave senza permesso di
#   cancellare gli snapshot):
#     BACKUP_REMOTE_REPOSITORY=s3:https://s3.esempio.it/nome-bucket/timone
# NON ammessi: cartelle o NAS montati sul server (SMB/NFS), SFTP, http senza
# TLS, credenziali scritte nell'indirizzo. backup-check li rifiuta.
# Configurazione lato destinazione e firewall: docs/OPERATIONS.md.
BACKUP_REMOTE_REPOSITORY=DA_CONFIGURARE

# Solo rest-server: utente e password dell'htpasswd del rest-server.
BACKUP_REMOTE_REST_USERNAME=
BACKUP_REMOTE_REST_PASSWORD=

# Solo S3: chiavi di accesso SENZA permesso di cancellare gli snapshot
# (s3:DeleteObject ammesso solo sul prefisso locks/). Le credenziali che
# cancellano servono alla pulizia annuale e non devono MAI stare qui.
BACKUP_REMOTE_S3_ACCESS_KEY_ID=
BACKUP_REMOTE_S3_SECRET_ACCESS_KEY=
BACKUP_REMOTE_S3_REGION=

# Certificato della CA, se la destinazione usa un certificato interno (non
# di una CA pubblica). Percorso relativo alla cartella del progetto, es.
# backup-secrets/ca-backup.pem. Vuoto = CA pubbliche del sistema.
BACKUP_REMOTE_CACERT=

# Spazio a disposizione sulla destinazione, in GB (vuoto = non noto: il
# controllo della percentuale non si fa).
BACKUP_REMOTE_QUOTA_GB=

# Limite di banda verso la destinazione, in KiB/s (vuoto = nessun limite).
# Utile se la connessione del server è condivisa con l'ufficio.
BACKUP_REMOTE_UPLOAD_LIMIT_KIB=

# --- Seconda copia remota (facoltativa) ---------------------------------------
# Una seconda copia immutabile fuori dall'intranet (es. S3 con Object Lock
# presso un fornitore esterno, se la prima è un NAS in ufficio). Stesse
# regole e stesse variabili della prima, con il prefisso BACKUP_REMOTE_2_.
# Vuota = non usata (nessun avviso).
BACKUP_REMOTE_2_REPOSITORY=
BACKUP_REMOTE_2_REST_USERNAME=
BACKUP_REMOTE_2_REST_PASSWORD=
BACKUP_REMOTE_2_S3_ACCESS_KEY_ID=
BACKUP_REMOTE_2_S3_SECRET_ACCESS_KEY=
BACKUP_REMOTE_2_S3_REGION=
BACKUP_REMOTE_2_CACERT=
BACKUP_REMOTE_2_QUOTA_GB=
BACKUP_REMOTE_2_UPLOAD_LIMIT_KIB=

# Soglia di avviso per lo spazio usato sulle destinazioni remote, in percento.
BACKUP_REMOTE_WARN_PERCENT=80

# --- Avvisi -------------------------------------------------------------------
# Chi riceve le mail di avviso (backup fallito, backup troppo vecchio,
# spazio, copia remota non configurata). Più indirizzi separati da virgola.
# Non dipende dagli utenti dell'app. Prova con:
#   docker compose exec app php artisan timone:backup-test-alert
BACKUP_ALERT_EMAIL=sistemista@esempio.it,redazione@esempio.it

# Dopo quante ore senza un backup riuscito parte l'avviso. 26 = un giorno
# più il margine di un backup notturno che finisce tardi.
BACKUP_MAX_AGE_HOURS=26

# Spazio libero minimo sul disco della copia locale, in GB.
BACKUP_LOCAL_MIN_FREE_GB=10


# --- Conservazione (copia locale) ---------------------------------------------
# Tutti i backup delle ultime 48 ore, poi 1 al giorno per 14 giorni,
# 1 a settimana per 8 settimane, 1 al mese per 12 mesi.
BACKUP_KEEP_WITHIN=48h
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Percentuale dei dati riletta e verificata dal controllo settimanale.
BACKUP_CHECK_READ_SUBSET=10%

# --- Altri percorsi da salvare --------------------------------------------------
# Cartelle dell'host fuori dal progetto (es. proxy HTTPS e certificati),
# separate da spazio, come si vedono DENTRO il container: vanno montate in
# sola lettura sotto /host con un docker-compose.override.yml (esempio in
# docs/OPERATIONS.md). Vuoto = nessuna.
#   BACKUP_EXTRA_PATHS=/host/etc/nginx /host/etc/letsencrypt
BACKUP_EXTRA_PATHS=

# Fuso orario degli orari dei backup (8, 12, 16, 20 e la notte).
BACKUP_TIMEZONE=Europe/Rome
