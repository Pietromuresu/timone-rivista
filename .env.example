APP_NAME="Timone Rivista"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=timone
DB_USERNAME=timone
DB_PASSWORD=

# Fuori da Docker (sviluppo rapido senza docker-compose, vedi HANDOFF.md):
# DB_CONNECTION=sqlite
# (DB_HOST/PORT/DATABASE/USERNAME/PASSWORD sopra vengono ignorati con sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb: server WebSocket self-hosted, nessun servizio esterno a pagamento.
# REVERB_APP_ID/KEY/SECRET vengono generati da "php artisan reverb:install" e devono
# essere identici tra il servizio "app"/"worker" e il servizio "reverb" nel
# docker-compose (tutti leggono lo stesso file .env).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# REVERB_HOST/PORT/SCHEME sono letti anche lato SERVER (config/broadcasting.php):
# è l'indirizzo che i container "app"/"worker" usano per PUBBLICARE un evento
# verso Reverb quando si chiama broadcast(...). In Docker deve essere il nome
# del servizio Reverb sulla rete interna, non un host raggiungibile dal browser.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Host/porta su cui il processo "reverb:start" si mette effettivamente in
# ascolto dentro il proprio container (di norma non vanno cambiati).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# VITE_REVERB_* sono invece letti dal BROWSER (Echo lato client, via Vite) per
# aprire la connessione WebSocket dall'esterno: NON possono puntare al nome
# Docker interno "reverb" (irrisolvibile fuori dalla rete del compose) — vanno
# valorizzati con l'host/porta pubblicamente raggiungibili (qui: il servizio
# "reverb" esposto sull'host su 8080, quindi "localhost" in sviluppo locale
# con Docker; in un vero deploy sarà il dominio pubblico).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Variabili lette da docker-compose.yml (non da Laravel) per il servizio
# "mysql" e per "backup" — `docker compose` carica automaticamente questo
# stesso file .env dalla cartella del progetto, non ne serve un secondo.
# Tenerle allineate a DB_DATABASE/DB_USERNAME/DB_PASSWORD sopra.
# ---------------------------------------------------------------------------
MYSQL_DATABASE=timone
MYSQL_USER=timone
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
