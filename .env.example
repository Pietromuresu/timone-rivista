# =============================================================================
# COME USARE QUESTO FILE
# =============================================================================
#
# Non serve compilarlo a mano: esegui
#
#     ./setup.sh
#
# dalla cartella del progetto. Lo script copia questo file in ".env" (se non
# esiste già) e genera automaticamente TUTTE le password/chiavi segnate come
# "OBBLIGATORIA, generata da ./setup.sh" qui sotto — non devi inventarti o
# copiare nessun valore a mano. Alla fine ./setup.sh avvia anche l'intero
# ambiente Docker e stampa un riepilogo con gli URL da aprire.
#
# Questo file serve solo come riferimento — per capire cosa fa ogni variabile
# se un giorno serve cambiarla a mano (es. per un deploy vero, non locale).
#
# =============================================================================

# -----------------------------------------------------------------------------
# Applicazione
# -----------------------------------------------------------------------------

APP_NAME="Timone Rivista"
APP_ENV=local
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Chiave di cifratura interna di Laravel (sessioni, cookie, dati cifrati).
# OBBLIGATORIA, generata da ./setup.sh — non va mai copiata da un altro
# progetto o condivisa: se cambia, tutte le sessioni/i dati cifrati esistenti
# diventano illeggibili.
APP_KEY=

APP_DEBUG=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL, dentro Docker)
# -----------------------------------------------------------------------------
# DB_DATABASE/DB_USERNAME/DB_PASSWORD sono le uniche credenziali del database
# applicativo: "docker-compose.yml" fa in modo che il container MySQL usi
# QUESTE STESSE variabili per creare l'utente/il database (non esiste più una
# coppia "MYSQL_..." separata da tenere allineata a mano: è la stessa cosa
# letta due volte, non può andare fuori sincrono).

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=timone
DB_USERNAME=timone

# Password del database applicativo.
# OBBLIGATORIA, generata da ./setup.sh.
DB_PASSWORD=

# Password dell'utente "root" di MySQL (diverso dall'utente applicativo sopra
# — usato solo dagli healthcheck interni di Docker, l'app non lo usa mai).
# OBBLIGATORIA, generata da ./setup.sh.
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Sessioni, cache, code (Redis, dentro Docker)
# -----------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Laravel Reverb (WebSocket self-hosted, nessun servizio esterno a pagamento)
# -----------------------------------------------------------------------------
# REVERB_APP_ID/KEY/SECRET identificano l'installazione locale di Reverb:
# devono solo essere non vuoti e coerenti tra i servizi "app"/"worker" e il
# servizio "reverb" — dato che tutti leggono lo stesso file .env, basta che
# ./setup.sh li generi una volta sola qui.
# OBBLIGATORIE, generate da ./setup.sh.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# REVERB_HOST/PORT/SCHEME sono letti anche lato SERVER (config/broadcasting.php):
# è l'indirizzo che i container "app"/"worker" usano per PUBBLICARE un evento
# verso Reverb quando si chiama broadcast(...). In Docker deve essere il nome
# del servizio Reverb sulla rete interna, non un host raggiungibile dal browser.
# Ha già un valore corretto per l'uso con Docker: non cambiarlo.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Host/porta su cui il processo "reverb:start" si mette effettivamente in
# ascolto dentro il proprio container. Valore corretto per Docker: non
# cambiarlo.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# VITE_REVERB_* sono invece letti dal BROWSER (Echo lato client) per aprire
# la connessione WebSocket dall'esterno: NON possono puntare al nome Docker
# interno "reverb" (irrisolvibile fuori dalla rete del compose) — vanno
# valorizzati con l'host/porta pubblicamente raggiungibili. Corretti già così
# per l'uso in locale con Docker (http://localhost:8080); in un vero deploy
# andranno cambiati con il dominio pubblico.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# -----------------------------------------------------------------------------
# Posta (solo log in locale: nessuna email viene davvero inviata)
# -----------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Storage remoto (non usato in locale — l'app salva i file dentro il
# container/volume Docker, non su S3. Righe presenti solo perché Laravel le
# si aspetta nel file di config; puoi ignorarle)
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
